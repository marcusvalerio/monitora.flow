# Postgres (Neon). Use a connection string com sslmode=require.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Segredo exigido por /api/coletar (o mesmo vai na função "disparador" do Neon).
CRON_SECRET=troque-isto
# Avisos de "ônibus chegando" (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
